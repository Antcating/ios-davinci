+/* Goodix GT9886 Normandy: 2-byte header + 8 bytes/contact + 2 checksum.
+ * Unlike GT9896 Yellowstone, the checksum covers the entire event packet.
+ * No firmware/config request or controller memory write is attempted. */
+static int
+touch_gt9886_ack(void)
+{
+	const uint8_t ack[3] = {0x41, 0x00, 0};
+	return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+static bool
+touch_gt9886_checksum(const uint8_t *buf, unsigned len)
+{
+	if (len < GT9886_HEAD_LEN + 2u || len > 84u) {
+		return false;
+	}
+	uint8_t sum = 0;
+	for (unsigned i = 0; i < len; ++i) {
+		sum = (uint8_t)(sum + buf[i]);
+	}
+	return sum == 0;
+}
+
+static int
+touch_gt9886(void)
+{
+	uint8_t buf[GT9886_HEAD_LEN + TOUCH_MAX * GT9886_POINT_LEN + 2u] = {0};
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	/* The 12-byte initial read includes the first contact and its checksum.
+	 * For n>1, those two checksum bytes are part of the next contact and
+	 * the actual checksum is at the end of the complete frame. */
+	int err = touch_read(0x5d, GT9886_EVENT_REG, true, buf, 12u);
+	if (err) {
+		return err;
+	}
+	if (!buf[0]) {
+		return 0; /* no new event; retain previous active contacts */
+	}
+	if (!(buf[0] & 0x80u)) {
+		return (buf[0] & 0x40u) ? ENOTSUP : 0;
+	}
+	unsigned n = buf[1] & 15u;
+	if (n > TOUCH_MAX) {
+		(void)touch_gt9886_ack();
+		return EIO;
+	}
+	if (n > 1u) {
+		err = touch_read(0x5d, GT9886_EVENT_REG + 12u, true,
+		    buf + 12u, (n - 1u) * GT9886_POINT_LEN);
+		if (err) {
+			return err;
+		}
+	}
+	if (n && !touch_gt9886_checksum(buf,
+	    GT9886_HEAD_LEN + n * GT9886_POINT_LEN + 2u)) {
+		(void)touch_gt9886_ack();
+		return EIO;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + GT9886_HEAD_LEN + i * GT9886_POINT_LEN;
+		unsigned id = p[0];
+		unsigned px = (unsigned)p[1] | ((unsigned)p[2] << 8);
+		unsigned py = (unsigned)p[3] | ((unsigned)p[4] << 8);
+		if (id >= TOUCH_MAX || (mask & (1u << id)) ||
+		    px >= 1080u || py >= 2340u) {
+			(void)touch_gt9886_ack();
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	err = touch_gt9886_ack();
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
